# ─── Database Configuration ─────────────────────────────────────────────────
# PostgreSQL connection string for Prisma. Required for all database operations.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local dev: Use localhost. For production: Use Supabase or managed Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/rehearsync?schema=public"

# Direct database URL for Prisma migrations (optional, Supabase specific).
# Used for running migrations that bypass connection poolers.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/rehearsync?schema=public"

# ─── Authentication (NextAuth.js v5) ────────────────────────────────────────
# Base URL for your app. Required for NextAuth callbacks and redirects.
# Local dev: http://localhost:5000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:5000"

# Secret key for signing JWT tokens. Generate with: openssl rand -base64 32
# CRITICAL: Use a strong, unique value in production. Never commit this value.
NEXTAUTH_SECRET="generate-a-secret-with-openssl-rand-base64-32"

# ─── Google OAuth (Optional) ────────────────────────────────────────────────
# OAuth credentials from Google Cloud Console (https://console.cloud.google.com)
# Create OAuth 2.0 Client ID under APIs & Services > Credentials
# Redirect URI: {NEXTAUTH_URL}/api/v1/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Supabase Storage ───────────────────────────────────────────────────────
# Supabase project URL. Get from: https://supabase.com/dashboard/project/_/settings/api
# Format: https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# Supabase public anon key. Safe to expose in browser (public key).
# Get from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Supabase service role key. CRITICAL: Server-side only. Never expose to client.
# Get from: https://supabase.com/dashboard/project/_/settings/api
# Used for admin operations like deleting files, bypassing RLS policies.
SUPABASE_SERVICE_ROLE_KEY=""

# Storage bucket name for audio/sheet music assets.
# Create bucket in Supabase Storage: https://supabase.com/dashboard/project/_/storage
# Set to public for easier access, or private with signed URLs.
SUPABASE_STORAGE_BUCKET="rehearsync-assets"

# ─── Stripe Payment Processing ──────────────────────────────────────────────
# Stripe secret key. Get from: https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development, live keys (sk_live_...) for production.
STRIPE_SECRET_KEY=""

# Stripe webhook signing secret. Get from: https://dashboard.stripe.com/webhooks
# Used to verify webhook signatures from Stripe.
# Create endpoint: {NEXTAUTH_URL}/api/v1/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# Stripe Price IDs for subscription plans. Get from: https://dashboard.stripe.com/products
# Create products and prices for each tier (Band monthly/yearly, Agent monthly/yearly).
STRIPE_PRICE_BAND_MONTHLY=""
STRIPE_PRICE_BAND_YEARLY=""
STRIPE_PRICE_AGENT_MONTHLY=""
STRIPE_PRICE_AGENT_YEARLY=""

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# Resend API key. Get from: https://resend.com/api-keys
# Used for transactional emails: welcome, password reset, band invites.
RESEND_API_KEY=""

# From address for outbound emails. Must be verified domain in Resend.
# Format: "Display Name <email@yourdomain.com>"
# For testing, use Resend's sandbox: "onboarding@resend.dev"
EMAIL_FROM="RehearSync <noreply@send.rehearsync.com>"

# ─── AI Processing (Replicate + OpenAI) ─────────────────────────────────────
# Replicate API token. Get from: https://replicate.com/account/api-tokens
# Used for AI models: Demucs (stem separation), Essentia (beat detection), MR-MT3 (transcription).
REPLICATE_API_TOKEN=""

# Webhook secret for Replicate callbacks. Generate a random string (e.g., openssl rand -hex 32).
# Used to verify webhook signatures from Replicate.
# Webhook endpoint: {NEXT_PUBLIC_SUPABASE_URL}/functions/v1/replicate-webhook
REPLICATE_WEBHOOK_SECRET=""

# OpenAI API key. Get from: https://platform.openai.com/api-keys
# Used for GPT-4o: section analysis (Intro/Verse/Chorus detection), lead/rhythm guitar split.
OPENAI_API_KEY=""

# ─── WebSocket Server (Real-Time Sessions) ──────────────────────────────────
# WebSocket server URL for real-time transport sync during rehearsal sessions.
# Local dev: ws://localhost:3001
# Production: wss://your-ws-server.com (deploy separately from Next.js)
NEXT_PUBLIC_WS_URL="ws://localhost:3001"

# Port for WebSocket server. Only used when running `npm run ws:dev` locally.
# In production, deploy WS server separately (Railway, Render, Fly.io).
WS_PORT=3001
